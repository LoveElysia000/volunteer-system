# ----------------------------------------
# Image / deployment
# ----------------------------------------
# Use lowercase GHCR path, e.g. ghcr.io/ein/volunteer-system
APP_IMAGE=ghcr.io/your-github-username/volunteer-system
IMAGE_TAG=latest

# ----------------------------------------
# Application
# ----------------------------------------
TZ=Asia/Shanghai
APP_PORT=1109
APP_SECRET_KEY=change-app-secret-key
JWT_SECRET=change-jwt-secret
AI_API_KEY=

# ----------------------------------------
# MySQL
# ----------------------------------------
MYSQL_DATABASE=volunteer_system
MYSQL_USER=volunteer
MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_PASSWORD=change-app-password
